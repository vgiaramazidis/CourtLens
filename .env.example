# Copy this file to .env and replace the placeholders with local API keys.
# Never commit the real .env file.
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Default model used when a frontend request does not select a provider.
AI_SEARCH_PROVIDER=openai
AI_SEARCH_PROMPT_VARIANT=ontology

# Optional model configuration.
GEMINI_MODEL=gemini-3.5-flash
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_OUTPUT_TOKENS=4000

# Basketball database used by the backend. Set the actual server in .env.
SPARQL_ENDPOINT=http://127.0.0.1:8890/sparql
